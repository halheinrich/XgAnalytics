<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <IsPackable>false</IsPackable>
    <!-- The one exception to the repo-wide policy in Directory.Build.props:
         test classes are not a consumed API, so a doc file buys nothing and
         CS1591 would only add noise. Warnings-as-errors still applies. -->
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="AwesomeAssertions" />
    <PackageReference Include="coverlet.collector" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="xunit" />
    <PackageReference Include="xunit.runner.visualstudio" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\XgAnalytics\XgAnalytics.csproj" />
    <!-- The producer's record builders: tests build decision records through
         TestRecords rather than restating the records' construction. -->
    <ProjectReference Include="..\..\BgDataTypes_Lib\BgDataTypes_Lib.TestSupport\BgDataTypes_Lib.TestSupport.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- The launch profiles Visual Studio uses, copied beside the tests (under
         a name the test host will not mistake for its own) so
         LaunchProfilesTests reads the real file. -->
    <None Include="..\XgAnalytics\Properties\launchSettings.json" Link="XgAnalytics.launchSettings.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

</Project>